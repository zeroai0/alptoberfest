{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" },
    { "source": "/wheel", "destination": "/wheel.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
